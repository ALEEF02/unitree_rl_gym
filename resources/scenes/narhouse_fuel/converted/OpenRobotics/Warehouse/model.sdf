<sdf version="1.7">
    <model name="warehouse">
        <pose>0 0 0 0 0 0</pose>
        <self_collide>false</self_collide>
        
        <link name="warehouse_base">
            <pose>0 0 0 0 0 0</pose>
            <collision name="warehouse_collision">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>meshes/warehouse_colision.stl</uri>
                    </mesh>
                </geometry>
            </collision>
            <visual name="warehouse_visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>meshes/warehouse.obj</uri>
                    </mesh>
                </geometry>
            </visual>
            <visual name="drop_area_visual">
                <pose>0 0 0.101 0 0 0</pose>
                
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>meshes/warehouse.obj</uri>
                        <submesh>
                            <name>drop1</name>
                            <center>true</center>
                        </submesh>
                    </mesh>
                </geometry>
            </visual>
        </link>
        <static>1</static>
    </model>
</sdf>